<div class="current-status">
    <span id="store_synchronization_form_status_label" class="status-label">{l s='Initialization' mod='mncklevu'}</span>
    <img src="/img/loader.gif" id="store_synchronization_form_process_image" class="process-image" />
</div>
<div id="store_synchronization_form_progress_container" class="progress-container" style="display: none;">
    {l s='Progress' mod='mncklevu'}: <span id="store_synchronization_form_progress"></span>
</div>
<div id="store_synchronization_form_error_container" class="error-container" style="display: none;">
    {l s='Error' mod='mncklevu'}: <span id="store_synchronization_form_error"></span>
</div>
