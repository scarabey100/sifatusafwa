<div id="filtersSummary">
    <div class="filtersSummaryInitial">
        <span>{l s='FILTERS' mod='opartstat'} :</span>
        <span id="filtersSummaryItems_initial"></span>
    </div>
    <div class="filtersSummaryCompare" id="filtersSummaryDisplayCompareTo">
